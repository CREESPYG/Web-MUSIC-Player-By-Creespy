# Copy to .env and fill in real values. The .env file is git-ignored — never commit it.
# The client reads only the VITE_ pair at build time (Vite exposes import.meta.env).

# Supabase (client — required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase (server/ops contexts — optional in this single-file client build)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# NEV commit the real value — worst case compromise is a security incident.
SUPABASE_SECRET_KEY=your_service_role_secret_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/.well-known/jwks.json

# TURN (optional; enables voice through strict NATs). VITE_ values ARE
# embedded in the client bundle, so only use TEMPORARY credentials
# (coturn `static-auth-secret` TTL tokens minted per session) — never long-
# term static credentials.
VITE_TURN_SERVER_URL=turn:turn.example.com:3478?transport=udp
VITE_TURN_USERNAME=temporary-username
VITE_TURN_CREDENTIAL=temporary-credential